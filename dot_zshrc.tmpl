# ~/.zshrc - interactive shell config
# Load order: zshenv -> zprofile (login) -> zshrc (interactive) -> zlogin (login)

# p10k instant prompt must stay at the top. Code above it must not read input
# or print output.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#-------------------------------------------------
# Shell options
#-------------------------------------------------

# Stops zsh-autosuggestions rebinding widgets on every precmd
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

# ctrl+w stops at path separators, dots, hyphens; treats _ as part of a word
WORDCHARS='*?_[]~&;!#$%^(){}<>'

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_verify
setopt hist_fcntl_lock
setopt share_history
setopt interactive_comments
setopt no_beep
setopt auto_cd

#-------------------------------------------------
# PATH
#-------------------------------------------------

# PATH itself is set in ~/.config/zsh/path.zsh (via zshenv and zprofile)
typeset -U path PATH manpath MANPATH fpath FPATH
typeset -TUx INFOPATH infopath
infopath=("$HOMEBREW_PREFIX/share/info"(N-/) $infopath)
manpath=("$HOMEBREW_PREFIX/share/man"(N-/) $manpath '')
export MANPATH

# Cache helpers. Must come before `mise activate`.
source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/cache.zsh"

# mise puts the real dirs of all managed tools on PATH, in front of the shims.
# Everything below that checks for a command depends on it.
(($+commands[mise])) && eval "$(mise activate zsh)"

#-------------------------------------------------
# Environment
#-------------------------------------------------

# Variables that non-interactive shells also need are in ~/.zshenv

{{ if eq .chezmoi.os "darwin" -}}
export CLICOLOR=1
{{- end }}
{{ if eq .chezmoi.os "linux" -}}
export S_COLORS=auto
{{- end }}

# Coloured man pages via less
export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;31m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;32m'

#-------------------------------------------------
# Colours and fzf
#-------------------------------------------------

if _zsh_cached "$ZSH_CACHE_DIR/init/ls_colors" vivid generate {{ (index .theme .current_theme).vivid }}; then
  IFS= read -r LS_COLORS <"$ZSH_CACHE_DIR/init/ls_colors"
  export LS_COLORS
fi

[[ -f ~/.config/fzf/themes/{{ (index .theme .current_theme).fzf }}.sh ]] && source ~/.config/fzf/themes/{{ (index .theme .current_theme).fzf }}.sh

() {
  local -a _excludes=(.git node_modules .venv venv .terraform .terragrunt-cache)

  if (($+commands[bfs])); then
    local _bfs_exclude=${(j: -o -name :)_excludes}
    export FZF_DEFAULT_COMMAND="bfs . -mindepth 1 \( -type f -o -type d \) -exclude \( -name ${_bfs_exclude} \) -printf '%P\n' 2>/dev/null"
    export FZF_ALT_C_COMMAND="bfs . -mindepth 1 -type d -exclude \( -name ${_bfs_exclude} \) -printf '%P\n' 2>/dev/null"
  elif (($+commands[fd])); then
    local _fd_exclude=${(j: --exclude :)_excludes}
    export FZF_DEFAULT_COMMAND="fd --hidden --exclude ${_fd_exclude} --type file --type directory"
    export FZF_ALT_C_COMMAND="fd --hidden --exclude ${_fd_exclude} --type directory"
  fi

  if (($+commands[lsd])); then
    local _ls='lsd --group-directories-first --color=always --icon=always'
  else
    local _ls='ls --color=always'
  fi

  export FZF_CTRL_T_OPTS="--bind ctrl-/:toggle-preview --preview 'if [[ -d {} ]]; then ${_ls} -1F {}; else bat --color=always --line-range :500 {}; fi'"
  export FZF_ALT_C_OPTS="--bind ctrl-/:toggle-preview --preview '${_ls} -1F {}'"
}

((${+FZF_DEFAULT_COMMAND})) && export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

#-------------------------------------------------
# Completion
#-------------------------------------------------

# Completions that tools print on request. mise hook-env already provides
# completions for tools installed with packslip (fnox, usage).
_zsh_cached_comp kubectl completion zsh
_zsh_cached_comp uv generate-shell-completion zsh
_zsh_cached_comp mise completion zsh

_zsh_mise_comp_sync

ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

fpath=(
  "$ZSH_CACHE_DIR/completions"
  "$ZSH_CACHE_DIR/mise-completions"
  "$ZSH_PLUGIN_DIR/zsh-completions/src"
  "$HOMEBREW_PREFIX/share/zsh/site-functions"
  $fpath
)

_zsh_compinit

# Tools that use the binary itself as the completion handler
autoload -Uz bashcompinit && bashcompinit
(($+commands[aws_completer])) && complete -C aws_completer aws
(($+commands[terraform]))     && complete -C terraform terraform
(($+commands[terragrunt]))    && complete -C terragrunt terragrunt
(($+commands[packer]))        && complete -C packer packer

zmodload zsh/complist
zstyle ':completion:*' completer _extensions _complete _files
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache true
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR/zcompcache"
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' rehash true
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches found --%f'
zstyle ':completion:*:default' list-prompt '%S%M matches%s'
zstyle ':completion:*:functions' ignored-patterns '_*'

#-------------------------------------------------
# Keybindings
#-------------------------------------------------

bindkey -e
KEYTIMEOUT=10

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Both terminfo and hardcoded ANSI for portability across terminals
bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey "${terminfo[kcbt]}" reverse-menu-complete
bindkey '^[[Z' reverse-menu-complete

#-------------------------------------------------
# Tool integrations
#-------------------------------------------------

_zsh_cached_source fzf --zsh
_zsh_cached_source fnox activate zsh

source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/functions.zsh"
[[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh

#-------------------------------------------------
# Aliases
#-------------------------------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias vim='nvim'
alias jq='jaq'
alias k='kubectl'
alias lg='lazygit'

if (($+commands[lsd])); then
  alias ls='lsd --group-directories-first --icon=never'
else
  alias ls='ls --color=auto'
fi
alias ll='ls -lh'

alias batp='bat --paging=auto'
alias dig='dig +noall +answer +stats'
alias gap='git add --patch'
alias grep='grep --color=auto'
{{ if eq .chezmoi.os "linux" -}}
alias lsports='ss -tunalp | column -t'
{{ else -}}
alias lsports='lsof -iTCP -sTCP:LISTEN -nP'
{{- end }}

#-------------------------------------------------
# Plugins and prompt
#-------------------------------------------------

# zsh-autosuggestions binds widgets on the first prompt, so it also wraps
# widgets defined above (fzf).
[[ -r "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme" ]] && source "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# zoxide must be initialised last
_zsh_cached_source zoxide init zsh

_zsh_cache_prune
